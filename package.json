{
  "name": "worththewait",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:web": "pnpm --filter @wtw/web dev",
    "dev:api": "pnpm --filter @wtw/shared build && pnpm --filter @wtw/api start:dev",
    "build": "pnpm --filter @wtw/shared build && pnpm --filter @wtw/api build && pnpm --filter @wtw/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @wtw/api test",
    "test:e2e": "pnpm --filter @wtw/api test:e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @wtw/api prisma:migrate",
    "db:seed": "pnpm --filter @wtw/api db:seed",
    "setup": "pnpm install && pnpm --filter @wtw/shared build && pnpm db:up && pnpm --filter @wtw/api prisma:generate"
  }
}
