# Copy to .env and adjust. `docker compose up -d` from the repo root serves
# the development database on 5434.
NODE_ENV=development
PORT=4100

DATABASE_URL="postgresql://wtw:wtw@localhost:5434/worththewait?schema=public"

# Replace both before anything leaves a developer machine.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_REPLAY_SECRET="local-refresh-replay-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Signs guest invitation tokens.
INVITATION_TOKEN_SECRET="dev-invitation-secret-change-me"
RSVP_IDEMPOTENCY_SECRET="local-rsvp-idempotency-secret-change-me"

# Where the Next.js app is served; used for CORS and for building share links.
WEB_APP_URL="http://localhost:3000"

# Google sign-in stays hidden until both of these are set. The authorised
# redirect URI on the Google client is the web app's own callback:
# http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
CORS_ORIGINS="http://localhost:3000"

# Turnstile. Use Cloudflare's test keys locally; set production credentials in
# the deployment secret store. The bypass is disabled by default.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_HOSTNAME="localhost"
TURNSTILE_DEV_BYPASS=true

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Uploaded images. Production requires private R2 storage and signed read URLs.
MEDIA_STORAGE_DIR="var/media"
MEDIA_PUBLIC_PATH="/media"
MEDIA_MAX_BYTES=8388608
MEDIA_STORAGE_DRIVER="local"
MEDIA_SIGNED_URL_TTL_SECONDS=600
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
